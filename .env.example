# ============================================================
# Timeline 部署配置示例
# 复制为 .env 后填写实际值；.env 不要提交到版本库。
# 变量清单与 docs/DEPLOYMENT.md 第 5 章保持一致。
# ============================================================

# ---------- 通用 ----------
# 容器时区，固定北京时间，不做时区换算
TZ=Asia/Shanghai

# 应用端口（宿主机映射；容器内监听同为 5070）
APP_PORT=5070

# 应用镜像标签，用于升级与回滚（如 v0.1.0）
IMAGE_TAG=latest

# ---------- 数据库连接（指向已部署好的 PostgreSQL 独立实例） ----------
# 数据库为独立实例（独立容器或独立主机），不属于本部署的 compose，
# 应用只通过以下连接信息访问，不管理数据库的安装、数据目录和生命周期。
DB_NAME=timeline_dev_db
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_SSLMODE=disable

# 补充说明：
# 1. 业务表 schema 固定为 timeline 与 user（账号认证表在 user，其余在 timeline），
#    由应用常量管理，无需配置。
# 2. 数据库本身与数据库账号需要预先创建并授权；应用迁移只创建 schema 和表结构，
#    不创建数据库实例。
# 3. 若数据库与本应用在同一宿主机、是另一个容器，DB_HOST 需填可路由的宿主地址，
#    并视需要在 compose 中为 app 添加 extra_hosts: ["host.docker.internal:host-gateway"]，
#    或让两个容器加入同一个 Docker 网络。

# ---------- 会话与安全 ----------
# 会话 Cookie 是否带 Secure 属性。
# HTTPS 环境保持 true；纯 HTTP 内网部署必须改为 false，否则浏览器不会保存会话。
COOKIE_SECURE=true

# ---------- 运行行为 ----------
# 应用启动时自动执行数据库迁移（单实例部署，advisory lock 防并发）
RUN_MIGRATIONS=true

# 雪花 ID 工作节点号，单机部署固定为 1
SNOWFLAKE_WORKER_ID=1

# 日志级别：debug / info / warn / error
LOG_LEVEL=info

# 日志格式：text 或 json
LOG_FORMAT=text

# 日志文件基础路径。实际写入「目录/yyyyMMdd/文件名」，按北京时间每天新建日期目录，
# 跨天运行自动切换到新目录写入；同时保留容器标准输出通道（docker logs）。
LOG_FILE=/data/logs/app.log

# 附件存储目录（容器内路径，对应宿主机 deploy/data/uploads 挂载）
UPLOAD_DIR=/data/uploads

# ---------- 说明 ----------
# 1. AI 模型接口的 base_url、API Key、模型名称不通过环境变量管理，
#    全部在管理后台“模型接口预设”中配置，密钥由服务端加密存储。
# 2. 单文件大小、存储配额等业务限制以管理后台设置为准；
#    服务器级请求体上限使用应用默认值。
# 3. 备份脚本使用以上 DB_* 变量连接独立数据库实例执行 pg_dump。
