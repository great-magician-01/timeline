# ============================================================
# Timeline 部署配置示例
# 复制为 .env 后填写实际值；.env 不要提交到版本库。
# 变量清单与 docs/DEPLOYMENT.md 第 5 章保持一致。
# ============================================================

# ---------- 通用 ----------
# 容器时区，固定北京时间，不做时区换算
TZ=Asia/Shanghai

# 应用端口（宿主机映射；容器内监听同为 5070）
APP_PORT=5070

# 应用镜像标签，用于升级与回滚（如 v0.1.0）。
# docker compose build 会把该值作为 APP_VERSION 构建参数，经 -ldflags -X main.appVersion
# 注入二进制，启动日志与版本输出可据此确认实际运行版本。
IMAGE_TAG=latest

# 构建镜像时使用的 Go 模块代理；受限网络可改为 https://goproxy.cn,direct。
GOPROXY=https://proxy.golang.org,direct

# ---------- 部署工具（compose 与备份脚本使用，应用本身不读取） ----------
# 备份/恢复脚本使用的 PostgreSQL 客户端镜像（一次性容器执行 pg_dump/psql）。
# 默认 postgres:17-alpine；目标数据库主版本更高时必须改为对应主版本，
# 否则 pg_dump 无法导出、restore.sh 的版本检查也会中止。
PG_CLIENT_IMAGE=postgres:17-alpine

# ---------- 数据库连接（指向已部署好的 PostgreSQL 独立实例） ----------
# 数据库为独立实例（独立容器或独立主机），不属于本部署的 compose，
# 应用只通过以下连接信息访问，不管理数据库的安装、数据目录和生命周期。
DB_NAME=timeline_dev_db
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_SSLMODE=disable

# 补充说明：
# 1. 业务表 schema 固定为 timeline 与 user（账号认证表在 user，其余在 timeline），
#    由应用常量管理，无需配置。
# 2. 数据库本身与数据库账号需要预先创建并授权；应用迁移只创建 schema 和表结构，
#    不创建数据库实例。
# 3. 若数据库与本应用在同一宿主机、是另一个容器，DB_HOST 需填可路由的宿主地址，
#    并视需要在 compose 中为 app 添加 extra_hosts: ["host.docker.internal:host-gateway"]，
#    或让两个容器加入同一个 Docker 网络。

# ---------- 会话与安全 ----------
# 会话 Cookie 是否带 Secure 属性。
# HTTPS 环境保持 true；纯 HTTP 内网部署必须改为 false，否则浏览器不会保存会话。
COOKIE_SECURE=true

# 受信反向代理 IP 或 CIDR，多个值用英文逗号分隔；仅在实际代理地址明确时配置。
# 留空表示直连模式，不信任 X-Forwarded-For / X-Real-IP，防止伪造客户端 IP。
# 不允许 0.0.0.0/0 或 ::/0（信任所有代理会允许攻击者伪造 IP 绕过限频）。
# 示例：TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8
TRUSTED_PROXIES=

# 模型接口预设的 API Key 加密密钥。留空时由数据库连接信息派生
# （可避免密钥在数据库中明文可见，但数据库凭据泄露即等于模型密钥泄露）。
# 生产环境请设置一个足够长的随机值，并在备份时一并妥善保管：更换该值后
# 已保存的 API Key 无法解密，需要在管理后台重新填写。
# 备份脚本会把该值单独写入备份目录的 encryption-key.txt（权限 600，不回显）；
# 恢复时必须保持与原值一致，否则需要重新填写模型预设密钥。
# 示例：ENCRYPTION_KEY=请替换为随机字符串
ENCRYPTION_KEY=

# ---------- 运行行为 ----------
# 应用启动时自动执行数据库迁移（单实例部署，advisory lock 防并发）
RUN_MIGRATIONS=true

# 雪花 ID 工作节点号，单机部署固定为 1
SNOWFLAKE_WORKER_ID=1

# 日志级别：debug / info / warn / error
LOG_LEVEL=info

# 日志格式：text 或 json
LOG_FORMAT=text

# 日志文件基础路径。实际写入「目录/yyyyMMdd/文件名」，按北京时间每天新建日期目录，
# 跨天运行自动切换到新目录写入；同时保留容器标准输出通道（docker logs）。
LOG_FILE=/data/logs/app.log

# 附件存储目录（容器内路径，对应宿主机 deploy/data/uploads 挂载）
UPLOAD_DIR=/data/uploads

# ---------- 说明 ----------
# 1. 首次部署先执行 deploy/scripts/prepare.sh 创建并授权 deploy/data/uploads 与
#    deploy/data/logs（属主 UID/GID 10001，非 root 用户会提示 sudo）。
# 2. AI 模型接口的 base_url、API Key、模型名称不通过环境变量管理，
#    全部在管理后台“模型接口预设”中配置，密钥由服务端加密存储。
# 3. 单文件大小、单请求大小、存储配额、发帖与上传限频、临时附件保留期、
#    调用记录截断与保留期以管理后台“系统设置”为准，修改后即时生效；
#    未配置时使用代码内默认值（单文件 100 MiB、单请求 101 MiB、每用户 5 GiB 等）。
# 4. 备份脚本 `deploy/scripts/backup.sh` 使用以上 DB_* 变量连接独立数据库实例执行
#    pg_dump，使用 PG_CLIENT_IMAGE 作为客户端镜像，并把 ENCRYPTION_KEY 写入
#    独立的 encryption-key.txt；恢复脚本 `restore.sh` 使用同一 PG_CLIENT_IMAGE。
